# API 3Gevents (sync RSVP → dashboard mariée)
# Local  : http://localhost:4000/api/v1
# Render : https://VOTRE-API.onrender.com/api/v1
# Laisser vide tant que l'API 3G n'est pas en ligne (l'invitation s'affiche quand même)
THREEG_API_URL=
THREEG_TENANT_SLUG=mariage-lumiere-faida
THREEG_EVENT_SLUG=mariage-civil

# URL publique Vercel (ex: https://invitation-faida.vercel.app)
NEXT_PUBLIC_INVITATION_URL=

# Secret lecture admin /api/rsvp?secret=
RSVP_ADMIN_SECRET=
